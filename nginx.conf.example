# put this file in /etc/nginx/conf.d/warehouse.conf
upstream puma_server {
    server unix:/tmp/warehouse.sock fail_timeout=0;
}

server {
    server_name         [DOMAIN NAME HERE];
    ssl_certificate     /path/to/ssl.crt;
    ssl_certificate_key /path/to/ssl.key;

    root /home/user/warehouse/public;
    # expose this listener only on the tailscale network.
    # use your machine's tailscale ip address in place of 100.xxx.yyy.zzz.
    listen 100.xxx.yyy.zzz:20600 ssl;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;

    # artwork uploads need a large body; everything else is a small protobuf.
    client_max_body_size 1m;
    keepalive_timeout 5;

    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_redirect off;
    proxy_max_temp_file_size 0;
    proxy_read_timeout 600;
    proxy_send_timeout 600;
    proxy_buffering off;

    location ^~ /api/ {
        proxy_pass http://puma_server;
    }

    # artwork uploads come from the export driver over the tailnet.
    location = /api/artwork {
        client_max_body_size 1G;
        proxy_pass http://puma_server;
    }

    # puma authorizes media requests before nginx serves the internal aliases.
    # range requests allow phone playback to seek without fetching the whole file.
    location ^~ /music/ {
        limit_except GET { deny all; }
        proxy_pass http://puma_server;
    }

    location ^~ /artwork/ {
        limit_except GET { deny all; }
        proxy_pass http://puma_server;
    }

    location = / {
        try_files /index.html =404;
    }

    location / {
        try_files $uri =404;
    }

    location ^~ /accel/music/ {
        alias /home/user/warehouse/music/;
        internal;
    }

    location ^~ /accel/artwork/ {
        alias /home/user/warehouse/artwork/;
        internal;
    }
}
