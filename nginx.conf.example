# put this file in /etc/nginx/conf.d/warehouse.conf
upstream puma_server {
    server unix:/tmp/warehouse.sock fail_timeout=0;
}

# the funnel listener is public, so it gets limits the tailnet listener does not. tailscale
# does not forward the client's public ip to the backend (tailscale/tailscale#12972), so every
# funnel request arrives from 127.0.0.1 and per-client limiting is impossible. these zones key
# on the listening port instead: nginx does not count a request whose key is empty, so the
# tailnet listener is exempt and all funnel traffic shares one global bucket.
map $server_port $funnel {
    default '';
    20601   'funnel';
}

# funnel terminates tls on the public 443 and forwards plain http, so $scheme lies there.
map $funnel $forwarded_proto {
    default $scheme;
    'funnel' 'https';
}

# every authed route wants `Authorization: Bearer <jwt>`; requests without one can be turned
# away at nginx instead of waking puma. only POST /api/auth is exempt (it is the login).
map $http_authorization $bearer {
    default          0;
    '~*^Bearer\s+\S+' 1;
}

map $funnel$bearer $funnel_unauthed {
    default   0;
    'funnel0' 1;
}

limit_req_zone  $funnel zone=funnel_req:1m  rate=10r/s;
limit_req_zone  $funnel zone=funnel_auth:1m rate=5r/m;
limit_conn_zone $funnel zone=funnel_conn:1m;
limit_req_status  429;
limit_conn_status 429;

server {
    server_name         [DOMAIN NAME HERE];
    ssl_certificate     /path/to/ssl.crt;
    ssl_certificate_key /path/to/ssl.key;

    root /home/user/warehouse/public;
    # it's strongly recommended to only expose this port on the tailscale network, not the public internet.
    # if you run `ifconfig` and look for the tailscale interface, you can see the IP address of your
    # machine on the tailscale network. use that IP address in place of 100.xxx.yyy.zzz below.
    listen 100.xxx.yyy.zzz:20600 ssl;
    # the apple watch cannot join the tailnet, so `rake server:funnel` runs a permanent tailscale
    # funnel that forwards the public https port to this plain-http listener (no `ssl`: funnel
    # terminates tls itself). keep it on a dedicated port like 20601 so it can't collide with any
    # real https-on-443 server block on the box, and so the limits above can tell the two apart.
    # funnel must point here rather than at puma's unix socket, because /music/ and /artwork/
    # responses are empty X-Accel-Redirect replies that only nginx can fulfil.
    listen 127.0.0.1:20601;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;

    # the funnel hostname is effectively public and the bearer token is the only gate, so cap
    # what any one caller can spend. the burst covers a screenful of artwork fetches.
    limit_req  zone=funnel_req burst=30 nodelay;
    limit_conn funnel_conn 12;

    # only artwork uploads need a large body, and those come from the export driver on the
    # tailnet. everything else is a small protobuf.
    client_max_body_size 1m;
    keepalive_timeout 5;

    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Host $http_host;
    proxy_redirect off;
    proxy_max_temp_file_size 0;
    proxy_read_timeout 600;
    proxy_send_timeout 600;
    proxy_buffering off;

    # login is the only route reachable without a token, so it is the brute-force target, and
    # the watch never logs in -- it gets its token from the phone over watchconnectivity -- so
    # the funnel has no reason to publish it at all. the server-level limit has to be repeated
    # because limit_req is not inherited once this level declares one of its own.
    location = /api/auth {
        if ($funnel) { return 404; }
        limit_req zone=funnel_req  burst=30 nodelay;
        limit_req zone=funnel_auth burst=5  nodelay;
        proxy_pass http://puma_server;
    }

    # the only two api routes the watch calls (ios/Shared/LibraryClient.swift). an exact match
    # wins over the ^~ prefix below, so these stay reachable on the funnel with a bearer token.
    location = /api/version {
        if ($funnel_unauthed) { return 401; }
        proxy_pass http://puma_server;
    }

    location = /api/library {
        if ($funnel_unauthed) { return 401; }
        proxy_pass http://puma_server;
    }

    # everything else under /api/ is a phone & web write (updates, track edits, plays) that the
    # watch never makes, so a leaked watch token should not reach any of it from the public
    # hostname. 404 rather than 403 to match what / and the spa shell already do on the funnel.
    location ^~ /api/ {
        if ($funnel) { return 404; }
        proxy_pass http://puma_server;
    }

    # artwork uploads come from the export driver over the tailnet, never from a client.
    location = /api/artwork {
        if ($funnel) { return 403; }
        client_max_body_size 1G;
        proxy_pass http://puma_server;
    }

    location ^~ /music/ {
        if ($funnel_unauthed) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://puma_server;
    }

    location ^~ /artwork/ {
        if ($funnel_unauthed) { return 401; }
        limit_except GET { deny all; }
        proxy_pass http://puma_server;
    }

    # the web app is only served on the tailnet. the watch never loads it, and there is no
    # reason to publish the spa shell on the funnel hostname.
    location = / {
        if ($funnel) { return 404; }
        try_files /index.html =404;
    }

    location / {
        if ($funnel) { return 404; }
        try_files $uri =404;
    }

    location ^~ /accel/music/ {
        alias /home/user/warehouse/music/;
        internal;
    }

    location ^~ /accel/artwork/ {
        alias /home/user/warehouse/artwork/;
        internal;
    }
}
